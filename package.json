{
  "name": "@lopinx/wbp",
  "version": "2.0.0",
  "description": "Cross-platform WordPress AI publisher CLI — pick keyword, generate content, mix images, publish via REST API",
  "main": "skills/wbp/scripts/wbp.mjs",
  "bin": {
    "wbp": "skills/wbp/scripts/wbp.mjs"
  },
  "scripts": {
    "start": "node skills/wbp/scripts/wbp.mjs",
    "test": "node skills/wbp/scripts/__TEST__/selftest.mjs",
    "pick": "node skills/wbp/scripts/wbp.mjs pick",
    "publish": "node skills/wbp/scripts/wbp.mjs publish",
    "init": "node skills/wbp/scripts/wbp.mjs init",
    "install": "node skills/wbp/scripts/install.mjs"
  },
  "keywords": [
    "wordpress",
    "publisher",
    "cli",
    "ai",
    "s3",
    "qiniu",
    "minio"
  ],
  "author": "",
  "license": "WTFPL",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lopinx/wbp.git"
  },
  "bugs": {
    "url": "https://github.com/lopinx/wbp/issues"
  },
  "homepage": "https://github.com/lopinx/wbp#readme",
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "skills": {
    "wbp": {
      "path": "skills/wbp/SKILL.md"
    }
  },
  "files": [
    "skills/",
    "package.json",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ]
